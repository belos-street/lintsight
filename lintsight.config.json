{
  // lintsight 仓库自身配置（dogfood）——schema 校验由 @lintsight/config-bridge 提供
  "rules": {
    "lintsight/no-empty-catch": "error",
    "lintsight/no-async-array-method": "error",
    "lintsight/no-floating-promise": "error",
    "lintsight/no-swallowed-promise-error": "error",
    "lintsight/no-closure-loop-var": "error",
    "lintsight/no-array-map-side-effect": "warn",
    "lintsight/no-json-structured-clone": "warn",
    "lintsight/no-ignored-reduce-result": "error",
    "lintsight/no-empty-promise-catch": "error",
    "lintsight/no-async-constructor-call": "warn",
    "lintsight/no-sync-io-in-async": "warn",
    "lintsight/no-hardcoded-credentials": "error",
    "lintsight/no-unsafe-regex": "warn",
    "lintsight/no-prototype-pollution-syntax": "error",
    "lintsight/no-child-process-nonliteral": "error",
    "lintsight/no-non-literal-fs-filename": "warn",
    "lintsight/no-non-literal-require": "error",
    "lintsight/no-weak-hash": "warn",
    "lintsight/no-math-random-secret": "error",
    "lintsight/no-sensitive-storage": "error",
    "lintsight/no-innerhtml-assignment": "error",
    "lintsight/no-sql-concat": "error",
    "lintsight/no-cors-wildcard": "warn",
    "lintsight/no-vm-dynamic-code": "error",
    "lintsight/no-insecure-cookie": "warn"
  },
  "ignore": [],
  "overrides": [
    { "files": ["**/*.vue"], "processor": "@lintsight/vue" }
  ]
}
