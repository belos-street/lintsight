{
  "name": "lintsight",
  "version": "0.1.0-alpha.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "cli": "bun run packages/lintsight-cli/src/cli.ts",
    "test": "bun run build:rules && bun test ./packages ./scripts",
    "lint": "oxlint packages plugins",
    "lint:fix": "oxlint --fix packages plugins",
    "format": "oxfmt packages plugins",
    "format:check": "oxfmt --check packages plugins",
    "build:rules": "bun run scripts/build-rules.ts",
    "build:binary": "cargo build --release --manifest-path crates/lintsight-engine/Cargo.toml && bun build --compile packages/lintsight-cli/src/cli.ts --outfile dist/lintsight",
    "bench": "bun run scripts/bench.ts",
    "bench:save": "bun run scripts/bench.ts --save",
    "corpus:sync": "bun run scripts/corpus-sync.ts",
    "corpus:check": "bun run scripts/corpus-baseline.ts",
    "corpus:recall": "bun run scripts/corpus-recall.ts",
    "check:change-id": "bun run scripts/check-change-id.ts"
  },
  "engines": {
    "bun": ">=1.2"
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "oxfmt": "0.68.0",
    "oxlint": "1.83.0",
    "oxlint-tsgolint": "7"
  }
}
